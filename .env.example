# Export these into your shell or source this file after customizing it.
ENABLE_CRAWL4AI=false
ENABLE_AGENT_REACH=false
ENABLE_DOCLING=false
MAX_RESPONSE_BYTES=12000000
MAX_CONTENT_CHARS=120000
FETCH_TIMEOUT_SECONDS=18
ADAPTER_TIMEOUT_SECONDS=35
BENCHMARK_DATA_DIR=.benchmark_lab
BENCHMARK_QUEUE_SIZE=8
BENCHMARK_MAX_REPETITIONS=5
BENCHMARK_MIN_RELIABILITY_RUNS=3
BENCHMARK_ARTIFACT_MAX_CHARS=120000

# Optional, separately billed API evaluator. Manual ChatGPT review needs no API key.
ENABLE_OPENAI_EVALUATOR=false
OPENAI_EVALUATOR_MODEL=gpt-5-mini
OPENAI_EVALUATOR_MAX_OUTPUT_TOKENS=4000
OPENAI_EVALUATOR_TIMEOUT_SECONDS=60
OPENAI_EVALUATOR_MAX_RETRIES=2
