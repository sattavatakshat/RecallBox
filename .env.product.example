# Reference only. Load a private mode-0600 environment file outside Git.
# Never set RECALLBOX_MIGRATION_URL in the API service environment.
RECALLBOX_DATABASE_URL=postgresql://recallbox_api:REPLACE_PASSWORD@127.0.0.1:5432/recallbox
RECALLBOX_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
# A real public OIDC client per platform; keys must match mobile PROVIDER values.
# issuer, token_endpoint and jwks_uri come from reviewed provider discovery.
RECALLBOX_OIDC_PROVIDERS='{"oidc-ios":{"issuer":"https://REPLACE_ISSUER","client_id":"REPLACE_IOS_CLIENT_ID","token_endpoint":"https://REPLACE_ISSUER/token","jwks_uri":"https://REPLACE_ISSUER/jwks","redirect_uri":"app.recallbox.mobile://auth/callback"},"oidc-android":{"issuer":"https://REPLACE_ISSUER","client_id":"REPLACE_ANDROID_CLIENT_ID","token_endpoint":"https://REPLACE_ISSUER/token","jwks_uri":"https://REPLACE_ISSUER/jwks","redirect_uri":"app.recallbox.mobile://auth/callback"}}'
